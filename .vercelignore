# A leading "!" means negation in ignore-file syntax, and this directory really
# is named "!DiscordBot" - so the backslash escape is required to exclude it
# rather than accidentally force-include it.
\!DiscordBot/

# The verification suite talks to a running server; it is never part of a build.
scripts/

# Regenerated by `prisma generate` during the build.
src/generated/
