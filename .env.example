# Postgres. Neon free tier works: https://neon.tech
# The POOLED connection string - used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# The DIRECT (unpooled) connection string - same host without "-pooler".
# Used only by the Prisma CLI for migrations: DDL and Prisma's advisory locks
# do not survive a connection pooler. Falls back to DATABASE_URL if unset.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Discord OAuth - https://discord.com/developers/applications
# Add these redirect URLs to the app's OAuth2 settings:
#   http://localhost:3000/api/auth/callback/discord
#   https://<your-vercel-domain>/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Any random 32+ byte string. Generate one with: npx auth secret
AUTH_SECRET=""

# Set to your public URL in production (Vercel sets this automatically).
# AUTH_URL="https://your-domain.vercel.app"
